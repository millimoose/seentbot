{
  "name": "seentbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.0"
  },
  "scripts": {
    "dev": "bun --watch src/bot.ts",
    "start": "bun src/bot.ts",
    "build": "bunx prisma generate && bunx prisma db push",
    "typecheck": "bun tsc --noEmit",
    "lint": "bunx oxlint --type-aware --type-check ./src",
    "test": "bun test",
    "prisma:generate": "bunx prisma generate",
    "prisma:studio": "bunx prisma studio"
  },
  "dependencies": {
    "@logtape/logtape": "^2.1.1",
    "@logtape/pretty": "^2.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "discord.js": "^14.26.4",
    "pg": "^8.21.0",
    "prisma-adapter-bun-sqlite": "^0.8.0",
    "sharp": "^0.34.5",
    "typeid-js": "^1.2.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}